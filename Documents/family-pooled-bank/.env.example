# ========================================================
# NaijaFamily Pooled Bank - Environment Configuration
# ========================================================
# Copy this file to '.env' and fill in your actual SMTP credentials.
# IMPORTANT: Never commit '.env' with sensitive credentials to version control.

# Server Configuration
PORT=5000
HOST=localhost
APP_URL=http://localhost:5173

# Nodemailer / SMTP Email Service Configuration
# Recommended: Use Gmail with an App Password, or Mailgun / SendGrid / Brevo / Resend / AWS SES
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication Credentials
# For Gmail: Use a 16-character Google App Password (not your normal Gmail password)
# https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=

# Email Sender Information
EMAIL_FROM="NaijaFamily Pooled Bank" <noreply@naijafamilybank.org.ng>
EMAIL_REPLY_TO=support@naijafamilybank.org.ng
