# ========================================================
# OnePot - Environment Configuration
# "One family, one pot = No stories"
# ========================================================
# Copy this file to '.env' and fill in your actual SMTP & Paystack credentials.
# IMPORTANT: Never commit '.env' with sensitive credentials to version control.

# Server Configuration
PORT=5000
HOST=localhost
APP_URL=http://localhost:5173

# Nodemailer / SMTP Email Service Configuration (Mailtrap or Ethereal Sandbox)
# For Mailtrap Sandbox:
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USER=your_mailtrap_user
#   SMTP_PASS=your_mailtrap_pass
# For Ethereal Email Sandbox (Default):
#   Leave SMTP_USER and SMTP_PASS empty to auto-generate a test inbox with preview URLs!
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication Credentials (leave blank to auto-provision sandbox)
SMTP_USER=
SMTP_PASS=

# Email Sender Information
SMTP_FROM="OnePot" <noreply@onepot.app>
EMAIL_FROM="OnePot" <noreply@onepot.app>
EMAIL_REPLY_TO=support@onepot.app

# Paystack Sandbox Payment Gateway Configuration
# Closed-loop mock banking ledger for academic demonstration
PAYSTACK_SECRET_KEY=sk_test_mock_onepot_sandbox_key_987654321
PAYSTACK_PUBLIC_KEY=pk_test_mock_onepot_sandbox_key_123456789

# Live Aiven Cloud MySQL Database Configuration
DB_HOST=mysql-budget10b4a6-magegraphics0-1cf6.f.aivencloud.com
DB_PORT=19258
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_NAME=defaultdb
DATABASE_URL=mysql://avnadmin:your_aiven_password@mysql-budget10b4a6-magegraphics0-1cf6.f.aivencloud.com:19258/defaultdb

